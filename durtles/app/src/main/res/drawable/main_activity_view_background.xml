<?xml version="1.0" encoding="utf-8"?>
<!-- KanjiKodama panel: hard offset shadow, chunky outline, window fill. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="4dp" android:top="6dp"><shape android:shape="rectangle"><corners android:radius="14dp"/><solid android:color="?attr/mmShadow"/></shape></item>
    <item android:right="4dp" android:bottom="6dp"><shape android:shape="rectangle"><corners android:radius="14dp"/><solid android:color="?attr/tileColorBackground"/><stroke android:width="3dp" android:color="?attr/mmOutline"/>
        <!-- inner padding: keeps panel content inside the outline and clear of the shadow band -->
        <padding android:left="9dp" android:top="8dp" android:right="13dp" android:bottom="15dp"/></shape></item>
</layer-list>
