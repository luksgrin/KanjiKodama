    <item android:left="4dp" android:top="6dp"><shape android:shape="rectangle"><corners android:radius="14dp"/><solid android:color="?attr/mmShadow"/></shape></item>
    <item android:right="4dp" android:bottom="6dp"><shape android:shape="rectangle"><corners android:radius="14dp"/><solid android:color="?attr/tileColorBackground"/><stroke android:width="3dp" android:color="?attr/mmOutline"/></shape></item>
</layer-list>
