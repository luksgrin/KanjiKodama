<?xml version="1.0" encoding="utf-8"?>
<!--
  KanjiKodama: server mode may point at a self-hosted server on the home network or localhost,
  which often has no certificate. Plain http is only ever used when such an address is typed in.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
