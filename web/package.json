{
  "name": "kanjikodama-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:lan": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "content:spike": "node scripts/copy-content.mjs",
    "icons": "node scripts/make-icons.mjs",
    "check": "sh scripts/check.sh",
    "check:core": "node scripts/check-core-imports.mjs",
    "golden:coverage": "node test/golden/coverage.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3",
    "dexie": "4.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sql.js": "1.15.0",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.4.11",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.6",
    "jsdom": "30.1.3",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  }
}
